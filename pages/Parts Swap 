def gerar_installation_summary(local, rdl, descricao, itens_extras):
    # Monta a lista de itens extras
    if itens_extras:
        extras_texto = "\nAdditional materials used:\n"
        for item in itens_extras:
            extras_texto += f"- {item}\n"
    else:
        extras_texto = ""

    texto = f"""
WJS Large Carmanah - {rdl} Installation Summary

Upon arrival at the site, the retailer indicated the preferred installation location and desired height for the sign.
{descricao}

After completion, I explained the work performed to the retailer and demonstrated that the equipment was operating correctly.
{extras_texto}
"""
    return texto.strip()


# =========================
# Entrada do usuário
# =========================
local = input("Enter Place's Name: ")
rdl = input("Enter RDL Number (ex: RDL 43741): ")

descricao = input(
    "\nDescribe any issues or relevant details during installation:\n"
)

# Itens extras
itens_extras = []
print("\nEnter additional materials used (press ENTER to finish):")

while True:
    item = input("- ")
    if item.strip() == "":
        break
    itens_extras.append(item)

# =========================
# Geração do texto
# =========================
texto_final = gerar_installation_summary(
    local,
    rdl,
    descricao,
    itens_extras
)

print("\nGenerated Installation Summary:\n")
print(texto_final)

# Salva em arquivo
with open("installation_summary.txt", "w") as arquivo:
    arquivo.write(texto_final)

print("\nFile 'installation_summary.txt' saved successfully!")